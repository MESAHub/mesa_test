#! /usr/bin/env ruby

# if :development, submit cases to localhost:3000 and load local mesa_test library
# rather than system version and run out of local lib, not installed
# if :staging, submit to beta version and run out of local lib, not installed
# anything else: trust rubygems to get lib and submit to real deal testhub
MODE = :production

case MODE
when :staging, :development
  require_relative '../lib/mesa_test'
else
  require 'mesa_test'
end

require 'thor'
require 'yaml'

class MesaTest < Thor
  DEVELOPMENT_URI = 'http://localhost:3000'.freeze
  STAGING_URI = 'https://beta-testhub.herokuapp.com'.freeze

  desc 'test [TEST CASE]', 'run and submit a test case or commit'
  long_desc <<-LONGDESC
    If you specify an optional test case, only that test case
    will be tested. Otherwise all test cases in your work directory (set up in
    your .mesa_test.yml file). TEST_CASE can also be an integer corresponding
    to the position it has in do1_test_source (or a concatenated version of
    that file if no module is specified). Modules are searched/concatenated in
    this order:

    #{MesaTestCase.modules.map { |mod| '    ' + mod.to_s }.join(', ')}
  LONGDESC

  option :force, desc: 'When submitting, assume submission data in ' \
                       '~/.mesa_test.yml are correct rather than checking ' \
                       'with user.',
                 type: :boolean, default: true, aliases: '-f'
  option 'force-logs', desc: 'Submit logs for test case(s), even if they pass',
                       type: :boolean, default: false
  option :submit, desc: 'Submit results (if any) to MesaTestHub.',
                  type: :boolean, default: true
  option :module, desc: 'Which module to test and/or submit, if applicable.',
                  type: :string, default: 'all', aliases: '-m'
  option :mesadir, desc: 'Location of mesa dir, if not relying on config data',
                   type: :string
  option :claim, desc: 'Tell MesaTestHub this computer is working on the ' \
                       'commit (and its tests) so it shows as pending, not ' \
                       'untested. Use --no-claim if something else already ' \
                       'claimed it.',
                 type: :boolean, default: true

  def test(test_case_name = nil)
    s = if options[:submit]
          create_and_check_submitter(force: options[:force])
        else
          create_submitter(force: options[:force])
        end
    m = create_and_check_mesa(
      mesa_dir: work_dir(options[:mesadir], s.mesa_work),
      mirror_dir: s.mesa_mirror,
      mod: options[:module].downcase.to_sym,
      github_protocol: s.github_protocol
    )
    m.with_mesa_dir do
      if test_case_name
        # only testing one test case
        t = create_and_check_test_case(mesa: m, test_case_name: test_case_name,
                                       mod: options[:module].downcase.to_sym)

        if options[:submit] && options[:claim]
          s.claim(sha: m.sha, scope: 'test', mod: t.mod, test_case: t.test_name)
        end

        # run test
        t.do_one
  
        # bail out if not submitting
        return unless options[:submit]
  
        # submit results
        shell.say 'Submitting results to ' + s.base_uri + '... ', :blue
        s.submit_instance(m, t, force_logs: options['force-logs'])
      else
        claim_all_tests(s, m) if options[:submit] && options[:claim]

        # run all tests
        m.each_test_run(mod: options[:module].downcase.to_sym)
  
        # bail out if not submitting
        return unless options[:submit]
  
        shell.say 'Submitting results to ' + s.base_uri + '... ', :blue
        s.submit_commit(m, force_logs: options['force-logs'])
      end
    end
    shell.say "Done.\n", :green
  end

  desc 'submit [TEST CASE]', 'submit a test case or commit'
  long_desc <<-LONGDESC
    All tests are assumed to be in the default mesa directory (set as mesa_work
    in .mesa_test.yml. If you specify an optional test case, only that test case
    will be submitted. TEST_CASE can also be an integer corresponding to the
    position it has in do1_test_source (or a concatenated version of that file
    if no module is specified). Modules are searched/concatenated in this
    order:

    #{MesaTestCase.modules.map { |mod| '    ' + mod.to_s }.join(', ')}
  LONGDESC

  option :force, desc: 'When submitting, assume submission data in ' \
                       '~/.mesa_test.yml are correct rather than checking ' \
                       'with user.',
                 type: :boolean, default: true, aliases: '-f'
  option 'force-logs', desc: 'Submit logs for test case(s), even if they pass',
                       type: :boolean, default: false
  option :module, desc: 'Which module to test and/or submit, if applicable.',
                  type: :string, default: 'all', aliases: '-m'
  option :empty, desc: 'Whether any test cases will be submitted. Useful for '\
                       'indicating compilation status independently of ' \
                       'single test submissions.',
                 type: :boolean, default: false, aliases: '-e'
  option :mesadir, desc: 'Location of mesa dir, if not relying on config data',
                   type: :string

  def submit(test_case_name = nil)
    s = create_and_check_submitter(force: options[:force])
    m = create_and_check_mesa(
      mesa_dir: work_dir(options[:mesadir], s.mesa_work),
      mirror_dir: s.mesa_mirror,
      mod: options[:module].downcase.to_sym,
      github_protocol: s.github_protocol
    )
    empty = options[:empty]

    # default value for now; might change to false if we have a bad
    # installation or if a test case is specified
    m.with_mesa_dir do
      if test_case_name
        # just submitting one test case.
        # this is not an empty submission since there is one test case (the
        # +empty+ option is ignored in this case)
  
        t = create_and_check_test_case(mesa: m, test_case_name: test_case_name,
                                       mod: options[:module].downcase.to_sym)
        # submit results
        shell.say 'Submitting results to ' + s.base_uri + '... ', :blue
        s.submit_instance(m, t, force_logs: options['force-logs'])
        shell.say "Done.\n", :green
      else
        # submitting compilation information and either all tests (entire) or
        # no tests (empty)
        begin
          m.check_installation
        rescue MesaDirError
          shell.say %q{This MESA installation doesn't seem to be compiled } \
            'properly. Attempting to submit a compilation failure to '\
            'MESATestHub.', :red
          empty = true
        ensure
          # submit all tests
          s.submit_commit(m, empty: empty, force_logs: options['force-logs'])
        end
      end
    end
  end

  desc 'checkout [SHA]', 'checkout a commit'
  long_desc <<-LONGDESC
  Checks out a particular commit to default mesa directory (mesa_work in 
  .mesa_test.yml). Uses git worktree magic to avoid re-downloading all of
  mesa history if a mirror repo is already set up. Does not affect the
  user's MESA_DIR or other environment variables.

  If no sha is provided, defaults to main (if checkout is occuring).
  LONGDESC

  option :mesadir, desc: 'Location of mesa dir, if not relying on config data',
                   type: :string

  def checkout(sha = 'main')
    # assuming config wizard has already been set (perhaps a little reckless)
    # so that we can get at the work directory and mirror directory
    s = create_submitter(force: true)
    Mesa.checkout(sha: sha,
                  work_dir: work_dir(options[:mesadir], s.mesa_work),
                  mirror_dir: s.mesa_mirror,
                  github_protocol: s.github_protocol)
  end

  desc 'install [SHA]', 'checkout and install a commit'
  long_desc <<-LONGDESC
  Optionally checks out a particular commit to default mesa directory 
  (mesa_work in .mesa_test.yml). Then runs installation script in the work
  directory. Equivalent to an [optional] git checkout followed by going
  into the directory and running ./clean and ./install, but there is some git
  worktree magic on the backend to improve efficiency. SDK or compilers must be
  set up prior. Does not affect the user's MESA_DIR or other environment
  variables outside of execution.

  If no sha is provided, defaults to main (if checkout is occuring). SHA is
  ignored if using option --no-checkout

  If SHA is `best`, MesaTestHub picks the commit this computer should build
  next (see `mesa_test request_work`). If it asks for FPE checks, the build
  is compiled with MESA_FPE_CHECKS_ON=1, and you should keep that variable
  set when running this build's tests.
  LONGDESC

  option :checkout, desc: 'Whether a checkout needs to happen. Use '\
                          '--no-checkout if you already ran checkout.',
                    type: :boolean, default: true, aliases: '-c'
  option :mesadir, desc: 'Location of mesa dir, if not relying on config data',
                   type: :string
  option :claim, desc: 'Tell MesaTestHub this computer is working on the ' \
                       'commit (and its tests) so it shows as pending, not ' \
                       'untested. Use --no-claim if something else already ' \
                       'claimed it.',
                 type: :boolean, default: true
  option :modes, desc: 'Optional test modes this computer can run when a ' \
                       'commit asks for them (comma-separated: ' \
                       'full_inlists, fpe, converge, or none). Defaults to ' \
                       'the config file.',
                 type: :string

  def install(sha = 'main')
    # assuming config wizard has already been set (perhaps a little reckless)
    # so that we can get at the work directory and mirror directory
    s = create_submitter(force: true)
    rec = nil
    if sha == 'best'
      rec = dispatch_or_exit(s, scope: 'build')
      return unless rec

      sha = rec['commit_sha']
    end
    build_flags = rec ? dispatch_flags(rec) : {}
    m = if options[:checkout] || rec
          Mesa.checkout(
            sha: sha,
            work_dir: work_dir(options[:mesadir], s.mesa_work),
            mirror_dir: s.mesa_mirror,
            github_protocol: s.github_protocol
          )
        else
          create_and_check_mesa(
            mesa_dir: work_dir(options[:mesadir], s.mesa_work),
            mirror_dir: s.mesa_mirror,
            mod: :all,
            github_protocol: s.github_protocol
          )
        end
    if options[:claim]
      s.claim(sha: m.sha, scope: 'build', flags: build_flags,
              dispatched_at: rec && rec['dispatched_at'])
    end
    begin
      with_env(run_flag_env(fpe: build_flags[:fpe])) do
        m.clean
        m.install
      end
    rescue MesaDirError
      shell.say "\nFailed in compiling MESA.", :red
    else
      shell.say "\nSuccessfully compiled MESA commit #{m.sha}.", :green
      if build_flags[:fpe]
        shell.say 'Built with FPE checks (MESA_FPE_CHECKS_ON=1); keep that ' \
                  'set when running its tests.', :yellow
      end
    end
  end

  desc 'install_and_test [SHA]', 'Install, test, and submit an entire commit.'
  long_desc <<-LONGDESC
  Optionally checks out a particular commit (specified by SHA, which default to
  HEAD if not provided) to a mesa directory (mesa_work in .mesa_test.yml, 
  unless a custom location is provided by --workdir=MYDIR). Then go into the
  directory and run ./clean and ./install. SDK or compilers must be set up
  prior. Once installation is complete, run the test suite, and report results
  (commit and all test data) to MesaTestHub in a single request.
  Does not affect the user's MESA_DIR or other environment variables. This is
  basically a shortcut for running

    `mesa_test install SOME_SHA`

  followed by

    `mesa_test test`

  If no sha is provided, defaults to main (if checkout is occuring). SHA is
  ignored if using option --no-checkout

  If SHA is `best`, MesaTestHub drives the whole run instead:
  it picks the commit to build (and whether to build it with FPE checks),
  the build result is submitted on its own, and then tests run one at a
  time in the order MesaTestHub asks for them, each submitted as it
  finishes, until there is nothing left that this computer can usefully
  run. Commits asking for [ci optional] or [ci converge] get those reruns
  if your configured modes (or --modes) include them. --module and
  --no-submit don't apply in this mode.
  LONGDESC

  option :checkout, desc: 'Whether a checkout needs to happen. Use '\
                          '--no-checkout if you already ran checkout.',
                    type: :boolean, default: true, aliases: '-c'
  option :mesadir, desc: 'Location of mesa dir, if not relying on config data',
                   type: :string
  option :force, desc: 'When submitting, assume submission data in ' \
                       '~/.mesa_test.yml are correct rather than checking ' \
                       'with user.',
                 type: :boolean, default: true, aliases: '-f'
  option :submit, desc: 'Submit results (if any) to MesaTestHub.',
                  type: :boolean, default: true
  option :module, desc: 'Which module to test and/or submit, if applicable.',
                  type: :string, default: 'all', aliases: '-m'
  option :destroy, type: :boolean, desc: 'Delete mesa installation upon ' \
                   'submission of complete results.', default: false
  option :claim, desc: 'Tell MesaTestHub this computer is working on the ' \
                       'commit (and its tests) so it shows as pending, not ' \
                       'untested. Use --no-claim if something else already ' \
                       'claimed it.',
                 type: :boolean, default: true
  option :modes, desc: 'Optional test modes this computer can run when a ' \
                       'commit asks for them (comma-separated: ' \
                       'full_inlists, fpe, converge, or none). Defaults to ' \
                       'the config file.',
                 type: :string

  def install_and_test(sha='main')
    return install_and_test_best if sha == 'best'

    s = if options[:submit]
          create_and_check_submitter(force: options[:force])
        else
          # not submitting? don't check config file (risky!) still need
          # submitter to get work and mirror directories, though
          create_submitter(force: true)
        end

    m = if options[:checkout]
          Mesa.checkout(
            sha: sha,
            work_dir: work_dir(options[:mesadir], s.mesa_work),
            mirror_dir: s.mesa_mirror,
            github_protocol: s.github_protocol
          )
        else
          create_and_check_mesa(
            mesa_dir: work_dir(options[:mesadir], s.mesa_work),
            mirror_dir: s.mesa_mirror,
            mod: options[:module].to_sym,
            github_protocol: s.github_protocol
          )
        end

    claiming = options[:submit] && options[:claim]
    s.claim(sha: m.sha, scope: 'build') if claiming

    begin
      m.clean
      m.install
    rescue MesaDirError
      shell.say "\nFailed in compiling MESA.", :red
    else
      check_mesa(m)
      update_mesa(mesa: m, mod: options[:module].downcase.to_sym)
      claim_all_tests(s, m) if claiming

      # run all tests. Don't be fooled, whether or not a diff happens is set
      # by the diff attribute of the mesa object, set above.
      m.with_mesa_dir { m.each_test_run(mod: options[:module].downcase.to_sym) }
    ensure
      # submit all commit and test data
      successfully_submitted = false
      if options[:submit]
        successfully_submitted = s.submit_commit(
          m, force_logs: options['force-logs'])
      end

      # if requested, installation and submission are successful, destroy the
      # directory
      m.remove if successfully_submitted && options[:destroy] && m.installed?
    end
  end

  desc 'request_work', 'ask MesaTestHub what this computer should do next'
  long_desc <<-LONGDESC
  Asks MesaTestHub which commit this computer should build next (or, with
  --scope=test --sha=SHA, which test to run next on a commit it built) and
  prints the recommendation as JSON on STDOUT, including the run modes to
  use and the reasons it was picked. Prints nothing (and exits 0) when
  there is nothing useful to do. Read-only: nothing is claimed.
  LONGDESC

  option :scope, desc: 'build or test', type: :string, default: 'build',
                 enum: %w[build test]
  option :sha, desc: 'For --scope=test: the commit you built', type: :string
  option :modes, desc: 'Optional test modes this computer can run when a ' \
                       'commit asks for them (comma-separated: ' \
                       'full_inlists, fpe, converge, or none). Defaults to ' \
                       'the config file.',
                 type: :string

  def request_work
    s = create_submitter(force: true)
    rec = dispatch_or_exit(s, scope: options[:scope], sha: options[:sha])
    puts JSON.pretty_generate(rec) if rec
  end

  desc 'setup [CONFIG_FILE]', 'Setup MesaTestHub config file.'
  long_desc <<-LONGDESC
    If optional CONFIG_FILE is provided, search for that file and load it
    to provide default values for configuration. If not provided, the default
    file, ~/.mesa_test.yml, is used. The resulting config file is saved to
    the same location it was read from.
  LONGDESC
  def setup(config_file = File.join(ENV['HOME'], '.mesa_test', 'config.yml'))
    MesaTestSubmitter.new_from_config(config_file: config_file,
                                      force_setup: true)
  end

  desc 'search "QUERY"', 'retrieve JSON test instances matching QUERY'
  long_desc <<-LONGDESC
  Sends a GET request to the MesaTestHub search API. QUERY should be
  quoted. Credentials are read from your mesa_test config file and sent as
  URL query parameters (HTTPS is mandatory).

  Query syntax is the same key-value form used by the in-browser search box
  at testhub.mesastar.org/test_instances/search (see the "Query syntax"
  panel on that page). Example:

    mesa_test search "computer: Hercules; passed: false"

  The raw JSON response body is written to STDOUT, suitable for piping to
  jq or redirecting to a file. If the server reports any rejected query
  clauses in a `failures` array, those are also echoed to STDERR so they
  aren't silently dropped from downstream pipelines. On a non-success HTTP
  status, an error is written to STDERR and the command exits non-zero.
  LONGDESC

  def search(query)
    s = create_submitter(force: true)
    emit_search_response(s.search(query))
  end

  desc 'count "QUERY"', 'count test instances matching QUERY'
  long_desc <<-LONGDESC
  Like `search`, but hits the count endpoint. The response is a small JSON
  object containing the result-set size (and any `failures`). Use this
  before `search` when you don't know how large a result set will be.
  LONGDESC

  def count(query)
    s = create_submitter(force: true)
    emit_search_response(s.search_count(query))
  end

  private

  # `install_and_test best`: MesaTestHub picks the commit, then each test.
  def install_and_test_best
    unless options[:submit]
      raise Thor::Error, '`install_and_test best` submits as it goes; ' \
                         '--no-submit is not supported.'
    end
    s = create_and_check_submitter(force: options[:force])
    rec = dispatch_or_exit(s, scope: 'build')
    return unless rec

    build_flags = dispatch_flags(rec)
    m = Mesa.checkout(sha: rec['commit_sha'],
                      work_dir: work_dir(options[:mesadir], s.mesa_work),
                      mirror_dir: s.mesa_mirror,
                      github_protocol: s.github_protocol)
    if options[:claim]
      s.claim(sha: m.sha, scope: 'build', flags: build_flags,
              dispatched_at: rec['dispatched_at'])
    end

    # FPE checks are compiled in, so they cover the build and every test.
    with_env(run_flag_env(fpe: build_flags[:fpe])) do
      begin
        m.clean
        m.install
      rescue MesaDirError
        shell.say "\nFailed in compiling MESA.", :red
        s.submit_commit(m, empty: true)
        return
      end
      check_mesa(m)
      update_mesa(mesa: m, mod: :all)

      # Report the build on its own; this also fulfills the build claim.
      s.submit_commit(m, empty: true)
      caps = capabilities_for(s).merge(fpe: !!build_flags[:fpe])
      all_submitted = run_dispatched_tests(s, m, caps)
      m.remove if all_submitted && options[:destroy]
    end
  end

  # Ask for, claim, run, and submit one test at a time on +m+'s commit
  # until MesaTestHub has nothing more for this computer. Returns true if
  # every submission went through.
  def run_dispatched_tests(s, m, caps)
    seen = {}
    all_submitted = true
    m.with_mesa_dir do
      loop do
        rec = dispatch_or_exit(s, scope: 'test', sha: m.sha, capabilities: caps)
        break unless rec

        label = "#{rec['test_case_module']}/#{rec['test_case_name']}"
        key = [label, rec['flags']]
        if seen[key]
          # The last result evidently didn't register; don't spin.
          shell.say "MesaTestHub asked for #{label} again; stopping.", :red
          all_submitted = false
          break
        end
        seen[key] = true

        flags = dispatch_flags(rec)
        t = begin
          m.find_test_case(test_case_name: rec['test_case_name'],
                           mod: rec['test_case_module'].to_sym)
        rescue TestCaseDirError => e
          shell.say "#{e.message} Stopping.", :red
          all_submitted = false
          break
        end
        if options[:claim]
          s.claim(sha: m.sha, scope: 'test', mod: t.mod, test_case: t.test_name,
                  flags: flags, dispatched_at: rec['dispatched_at'])
        end
        # fpe is already set for the whole build
        with_env(run_flag_env(flags.merge(fpe: false))) { t.do_one }
        all_submitted &&= s.submit_instance(m, t, force_logs: options['force-logs'])
      end
    end
    all_submitted
  end

  # Claim every test on +m+'s commit in one request — only for whole-suite
  # runs, since claims for tests that never run would sit until they
  # expire.
  def claim_all_tests(s, m)
    return unless options[:module].to_s.downcase == 'all'

    s.claim(sha: m.sha, scope: 'test', all_test_cases: true)
  end

  def capabilities_for(s)
    options[:modes] ? s.parse_capabilities(options[:modes]) : s.capabilities
  end

  # Dispatch, or print the server's complaint and exit 1. nil means there's
  # nothing to do (said on STDERR so `request_work` STDOUT stays pure JSON).
  def dispatch_or_exit(s, scope:, sha: nil, capabilities: capabilities_for(s))
    rec = s.dispatch(scope: scope, sha: sha, capabilities: capabilities)
    if rec.nil?
      $stderr.puts 'MesaTestHub has nothing more for this computer to ' \
                   "#{scope == 'build' ? 'build' : 'test on this commit'} right now."
    elsif scope == 'build'
      $stderr.puts "MesaTestHub suggests #{rec['short_sha']} on #{rec['branch']}: " \
                   "#{Array(rec['reasons']).join('; ')}"
    end
    rec
  rescue TestHubError => e
    $stderr.puts e.message
    exit 1
  end

  def emit_search_response(response)
    if response.is_a?(Net::HTTPSuccess)
      puts response.body
      warn_search_failures(response.body)
    else
      $stderr.puts "Search request failed: HTTP #{response.code} "\
                   "#{response.message}"
      $stderr.puts response.body unless response.body.nil? || response.body.empty?
      exit 1
    end
  end

  def warn_search_failures(body)
    parsed = JSON.parse(body)
    failures = parsed['failures']
    return unless failures.is_a?(Array) && !failures.empty?

    $stderr.puts 'Warning: the following query clauses were rejected by '\
                 'the server and ignored:'
    failures.each { |f| $stderr.puts "  - #{f}" }
  rescue JSON::ParserError
    # Body wasn't JSON; nothing to surface.
  end

  def work_dir(given, default)
    if given
      File.expand_path('', given)
    else
      default
    end
  end

  def check_user_and_computer(submitter)
    computer_check = submitter.confirm_computer
    if computer_check['valid']
      puts computer_check['message']
    else
      $stderr.puts computer_check['message']
      exit 1
    end
  end

  def create_submitter(force: true)
    s = case MODE
        when :development
          MesaTestSubmitter.new_from_config(base_uri: DEVELOPMENT_URI)
        when :staging
          MesaTestSubmitter.new_from_config(base_uri: STAGING_URI)
        else
          MesaTestSubmitter.new_from_config
        end
    unless force
      s.setup unless s.confirm_computer_data
    end
    s
  end

  def create_and_check_submitter(force: true)
    s = create_submitter(force: force)
    check_user_and_computer s
    s
  end

  def create_and_check_mesa(mesa_dir: '', mirror_dir: '', mod: :all,
                            github_protocol: nil)
    m = Mesa.new(mesa_dir: mesa_dir, mirror_dir: mirror_dir,
                 github_protocol: github_protocol)
    check_mesa(m)
    update_mesa(mesa: m, mod: mod)
  end

  def check_mesa(mesa)
    return if mesa.downloaded?

    raise MesaDirError, "Invalid MESA_DIR: #{mesa.mesa_dir}. Please "\
      'download and install a valid MESA version or provide the path to one.'
  end

  def update_mesa(mesa:, mod: :all)
    mesa.load_test_source_data(mod: mod)
    mesa
  end

  def create_and_check_test_case(mesa:, test_case_name:, mod: :all)
    t = mesa.find_test_case(test_case_name: test_case_name, mod: mod)
    # return test case if it was found
    return t unless t.nil?

    # test case was not found. Throw an error.
    msg = "No such test case, #{test_case_name} found in any of "
    # this should care about the value in `mod`. Current behavior is only
    # appropriate if `mod` is :all.
    msg << MesaTestCase.modules.map do |this_mod|
      File.join(mesa.test_suite_dir(mod: this_mod), 'do1_test_source')
    end.join(' or ')
    msg << '.'
    raise TestCaseDirError, msg
  end
end

# actually start the CLI
MesaTest.start(ARGV)
